{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/agent-platform/scripts/work_session_hook.py\" --provider codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/agent-platform/scripts/work_session_hook.py\" --provider codex"
          }
        ]
      }
    ]
  }
}
